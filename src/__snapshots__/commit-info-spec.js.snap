exports[`commit-info > no environment variables > returns nulls for missing fields 1`] = `
{
  "author": null,
  "branch": "test-branch",
  "email": "me@foo.com",
  "ghaEventData": undefined,
  "message": null,
  "remote": null,
  "sha": "abc123",
